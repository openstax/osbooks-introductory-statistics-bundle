          <row><entry>Queen</entry><entry>15</entry><entry>172</entry><entry>647 min</entry><entry>3</entry></row>
          <row><entry>Madonna</entry><entry>15</entry><entry>175</entry><entry>798 min</entry><entry>4</entry></row>
          <row><entry>Taylor Swift</entry><entry>13</entry><entry>178</entry><entry>687 min</entry><entry>4</entry></row>
          <row><entry>Nine Inch Nails</entry><entry>14</entry><entry>183</entry><entry>817 min</entry><entry>4</entry></row>
